# Copy to .env next to docker-compose.yaml and fill in.

# The name clients and browsers use for this server. Keep it short: ICQ 2003b
# stores some links in its executable, and https://<PUBLIC_HOST>:8102 plus two
# characters has to fit in 40.
PUBLIC_HOST=icq.example.org

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=admin@example.org

# debug while setting up, info in production.
LOG_LEVEL=info

ADMIN_USER=admin
BACKUP_KEEP_DAYS=14

# age public keys the backups are encrypted to, comma-separated: yours, and
# optionally an offline spare. Only public keys (age1...) - the private key
# never goes on a server. Empty keeps plain backups (with a warning).
BACKUP_AGE_RECIPIENTS=
