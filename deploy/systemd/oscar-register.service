[Unit]
Description=ICQ Revival - registration and profile pages
After=network-online.target open-oscar-server.service
Wants=network-online.target
PartOf=open-oscar-server.service

[Service]
Type=simple
User=oscar
Group=oscar
WorkingDirectory=/opt/oscar-register
Environment="PORT=8099"
Environment="HOST=0.0.0.0"
Environment="API_BASE=http://127.0.0.1:8090"
Environment="OSCAR_HOST=chat.example.ts.net"
Environment="OSCAR_PORT=5190"
Environment="OSCAR_PORT_SSL=5193"
Environment="DB_PATH=/var/lib/open-oscar-server/oscar.sqlite"
# База сервера открывается на чтение (сверка пароля), а после удаления учётки —
# на запись: DELETE /user оставляет контакт-лист и профиль сиротами, и без
# уборки они достались бы следующему владельцу освободившегося номера.
ReadWritePaths=/var/lib/open-oscar-server
# Адреса восстановления и одноразовые ссылки — в своей базе,
# каталог создаёт сам systemd и отдаёт его сервису на запись.
StateDirectory=oscar-register
Environment="RECOVERY_DB=/var/lib/oscar-register/recovery.sqlite"
Environment="PUBLIC_BASE_URL=https://chat.example.ts.net:8444"
# Пароль почтового ящика держим отдельно, с правами 600.
EnvironmentFile=-/etc/oscar-register/mail.env
ExecStart=/usr/bin/node /opt/oscar-register/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
