[Unit]
Description=ICQ Revival - registration and profile pages
After=network-online.target open-oscar-server.service
Wants=network-online.target
PartOf=open-oscar-server.service

[Service]
Type=simple
User=oscar
Group=oscar
WorkingDirectory=/opt/oscar-register
Environment="PORT=8099"
Environment="HOST=0.0.0.0"
Environment="API_BASE=http://127.0.0.1:8090"
Environment="OSCAR_HOST=icq.example.com"
Environment="OSCAR_PORT=5190"
Environment="OSCAR_PORT_SSL=5193"
Environment="DB_PATH=/var/lib/open-oscar-server/oscar.sqlite"
# The server's database is opened for reading (password check) and, after an
# account is deleted, for writing: DELETE /user leaves the contact list and
# profile orphaned, and without cleanup they would pass to the next owner of
# the freed number.
ReadWritePaths=/var/lib/open-oscar-server
# Recovery addresses and one-time links live in their own database; systemd
# creates the directory itself and gives the service write access to it.
StateDirectory=oscar-register
Environment="RECOVERY_DB=/var/lib/oscar-register/recovery.sqlite"
Environment="PUBLIC_BASE_URL=https://icq.example.com:8444"
# The mailbox password is kept separately, with mode 600.
EnvironmentFile=-/etc/oscar-register/mail.env
ExecStart=/usr/bin/node /opt/oscar-register/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
