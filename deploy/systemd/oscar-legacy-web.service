[Unit]
Description=ICQ Revival - pages replacing the dead ICQ.com services
After=network-online.target open-oscar-server.service
Wants=network-online.target
PartOf=open-oscar-server.service

[Service]
Type=simple
User=oscar
Group=oscar
WorkingDirectory=/opt/oscar-legacy-web
Environment="PORT=8101"
# Listen on all addresses: nginx with TLS on 8102 sits in front of this
# service, and links in the client point at the host name, not 127.0.0.1.
Environment="BIND=0.0.0.0"
Environment="MGMT_API=http://127.0.0.1:8090"
Environment="REGISTER_BASE=https://icq.example.com:8444"
ExecStart=/usr/bin/node /opt/oscar-legacy-web/server.js
# services.json and topics.json can be reloaded without a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
