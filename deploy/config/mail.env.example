# Mail for ICQ password recovery.
# While the values are empty, the recovery page honestly replies that
# sending is not set up; everything else works as before.
#
# Port 465 is TLS from the first byte, 587 is STARTTLS; the mode follows
# the port and, if needed, is set explicitly via SMTP_MODE=implicit|starttls.
#
# After editing: sudo systemctl restart oscar-register

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_SECRET=
SMTP_FROM=
SMTP_FROM_NAME=ICQ Revival
