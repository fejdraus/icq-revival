# Почта для восстановления паролей ICQ.
# Пока значения пустые, страница восстановления честно отвечает,
# что отправка не настроена, — остальное работает как раньше.
#
# Порт 465 — TLS с первого байта, 587 — STARTTLS; режим определяется
# по порту, при нужде задаётся явно через SMTP_MODE=implicit|starttls.
#
# После правки: sudo systemctl restart oscar-register

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_SECRET=
SMTP_FROM=
SMTP_FROM_NAME=ICQ Revival
