.idea/
*.db
*.sqlite
dist/
*.DS_Store
certs/
.vscode/
.cursor/
clients/

# Python bytecode from the client tools
__pycache__/

# Container deployment: settings, secrets, certificates and backups stay on
# the machine they belong to
deploy/.env
deploy/secrets/*.env
deploy/certs/
deploy/backups/
# Miranda NG update packages of ours (tools/miranda-icq/make-update-packages.py),
# copied to the machine by hand: the engine in them is 15 MB
deploy/miranda-updates/
# The downloads of /icq/download (tools/make-downloads.py), copied by hand
deploy/downloads/

# Build output of the C# client patches (the exes are copied into tools\*\patch)
tools/patcher/**/bin/
tools/patcher/**/obj/

# Build output of the native client patches (tools\patcher-cpp\Build.ps1)
tools/patcher-cpp/obj/
tools/patcher-cpp/out/

# Build output of the ICQ 6.5 FlashPlayerControl.dll replacement (Rust)
tools/icq65/flashplayer/target/
# ...and its copies next to ICQ-6.5-Patch.exe and ICQ-7.2-Patch.exe
# (tools\common\Build-Patches.ps1): 15 MB, published with the release rather
# than kept in git.
tools/icq65/patch/FlashPlayerControl-Ruffle.dll
tools/icq72/patch/FlashPlayerControl-Ruffle.dll

# Build output of the ICQ E2E add-on (tools\icq-e2e, Rust)
tools/icq-e2e/target/
# ...and its copies next to ICQ-6.5-Patch.exe and ICQ-7.2-Patch.exe (owner-only
# test build; not shipped in the public download zips)
tools/icq65/patch/Icqe2eProbe-msimg32.dll
tools/icq72/patch/Icqe2eProbe.dll
