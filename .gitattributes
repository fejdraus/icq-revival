# Files that end up inside Linux containers keep LF on every checkout, so an
# image built from a Windows working copy still runs its scripts.
*.sh          text eol=lf
*.Dockerfile  text eol=lf
Dockerfile*   text eol=lf
*.conf        text eol=lf
*.env         text eol=lf
*.env.example text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
# Ruffle's web build is served byte for byte as published (its chunk names
# are content hashes): no line-ending conversion.
deploy/oscar-legacy-web/ruffle/** -text
# The Miranda NG ICQ plugin source as built (upstream + IcqOscarJ.diff) is
# kept byte for byte: Miranda's sources are CRLF, and the diff applies with
# patch --binary only to the untouched line endings.
tools/miranda-icq/IcqOscarJ/** -text
# Its diff against upstream likewise: its lines carry the sources' own
# endings, so it applies with patch --binary only when kept as generated.
tools/miranda-icq/IcqOscarJ.diff -text
# The backup scripts run on Linux hosts and have no extension.
deploy/backup/icq-backup-* text eol=lf
