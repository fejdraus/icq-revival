+			if (((LPNMHDR)lParam)->idFrom == 0 && ((LPNMHDR)lParam)->code == PSN_INFOCHANGED)
+				break;
+			[[fallthrough]];
+
+		default:
+			if (INT_PTR res = m_pfnProc(m_hwnd, msg, wParam, lParam))
+				return res;
+		}
+
+		return CUserInfoPageDlg::DlgProc(msg, wParam, lParam);
+	}
+};
