-		}
-
-		// Set last xstatus
-		updateServerCustomStatus(TRUE);
-	}
-	info->isMigrating = false;
-
-	mir_cslock l(m_modeMsgsMutex);
-	char **szAwayMsg = MirandaStatusToAwayMsg(m_iStatus);
-	if (szAwayMsg)
-		icq_sendSetAimAwayMsgServ(*szAwayMsg);
