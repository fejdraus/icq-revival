+// Sets our animated avatar, the server list item "8" (BART type 8), as ICQ 6.5
+// does: pItem is the BART item (00 08 <flags> 10 <md5 of the document>); null
+// sets the standard "no icon" hash, which removes it. The picture's item "1"
+// (updateServAvatarHash, SrvAvatarID) is a different one and stays.
+void CIcqProto::updateServFlashAvatarHash(const BYTE *pItem)
+{
+	static const BYTE hashNoIcon[5] = { 0x02, 0x01, 0xD2, 0x04, 0x72 };
+
+	WORD wItemId = getWord(DBSETTING_SERVLIST_FLASHAVATAR, 0), wCommand;
+	if (wItemId == 0) {
+		if (pItem == nullptr) {
+			debugLogA("No Flash avatar item to remove.");
+			return;
+		}
+		wItemId = GenerateServerID(SSIT_ITEM, 0);
+		wCommand = ICQ_LISTS_ADDTOLIST;
+	}
+	else wCommand = ICQ_LISTS_UPDATEGROUP;
+
+	cookie_servlist_action *ack = (cookie_servlist_action*)SAFE_MALLOC(sizeof(cookie_servlist_action));
+	if (!ack)
+		return;
+	ack->dwAction = SSA_SETFLASHAVATAR;
+	ack->wContactId = wItemId;
+	ack->wGroupId = (wCommand == ICQ_LISTS_ADDTOLIST); // for the ack: added, not updated
+	DWORD dwCookie = AllocateCookie(CKT_SERVERLIST, wCommand, 0, ack);
+
+	// TLV(D5): flags, length, hash
+	BYTE hash[2 + 0x10];
+	WORD cbHash;
+	if (pItem) {
+		hash[0] = pItem[2];
+		hash[1] = 0x10;
+		memcpy(hash + 2, pItem + 4, 0x10);
+		cbHash = 2 + 0x10;
+	}
+	else {
+		hash[0] = 0;
+		hash[1] = sizeof(hashNoIcon);
+		memcpy(hash + 2, hashNoIcon, sizeof(hashNoIcon));
+		cbHash = 2 + sizeof(hashNoIcon);
+	}
+
+	WORD wTLVlen = 8 + cbHash;
+	icq_packet pBuffer;
+	pBuffer.wPlace = 0;
+	pBuffer.pData = (BYTE *)_alloca(wTLVlen);
+	pBuffer.wLen = wTLVlen;
+	packTLV(&pBuffer, SSI_TLV_NAME, 0, nullptr);
+	packTLV(&pBuffer, SSI_TLV_AVATARHASH, cbHash, hash);
+
+	debugLogA("%s our Flash avatar item %u.", pItem ? "Setting" : "Clearing", wItemId);
+	icq_sendServerItem(dwCookie, wCommand, 0, wItemId, "8", pBuffer.pData, wTLVlen, SSI_ITEM_BUDDYICON, SSOP_ITEM_ACTION, 400, nullptr);
+}
