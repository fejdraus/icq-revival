-
-		// CLI_REQBOS
-		debugLogA("Sending CLI_REQBOS");
-
-		serverPacketInit(&packet, 10);
-		packFNACHeader(&packet, ICQ_BOS_FAMILY, ICQ_PRIVACY_REQ_RIGHTS);
-		sendServPacket(&packet);
