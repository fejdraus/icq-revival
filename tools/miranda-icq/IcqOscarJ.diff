+
+// Our contact list event activated: the core's accept dialog for the request.
+INT_PTR CIcqProto::OpenFileRequest(WPARAM, LPARAM lParam)
+{
+	CLISTEVENT *cle = (CLISTEVENT *)lParam;
+	if (cle == nullptr)
+		return 0;
+
+	basic_filetransfer *bft = (basic_filetransfer *)cle->lParam;
+	if (!IsValidFileTransfer(bft) || bft->bAnswered)
+		return 0;
+
+	bft->hRecvNotify = 0; // the list removes its event itself
+	CLISTEVENT recv = {};
+	recv.hContact = bft->hContact;
+	recv.hDbEvent = bft->hRecvEvent;
+	recv.lParam = (LPARAM)bft;
+	CallService("SRFile/RecvFile", 0, (LPARAM)&recv);
+	return 0;
+}
+
+// When a request has no text (ICQ 6.5 sends none), its size is shown instead.
+char* CIcqProto::FileSizeDescription(unsigned __int64 qwSize)
+{
+	char szUnit[32], buf[64];
+	if (qwSize < 1024)
+		mir_snprintf(buf, "%u %s", (unsigned)qwSize, ICQTranslateUtfStatic(LPGEN("bytes"), szUnit, sizeof(szUnit)));
+	else if (qwSize < 1024 * 1024)
+		mir_snprintf(buf, "%.1f %s", qwSize / 1024.0, ICQTranslateUtfStatic(LPGEN("KB"), szUnit, sizeof(szUnit)));
+	else if (qwSize < 1024ull * 1024 * 1024)
+		mir_snprintf(buf, "%.1f %s", qwSize / (1024.0 * 1024), ICQTranslateUtfStatic(LPGEN("MB"), szUnit, sizeof(szUnit)));
+	else
+		mir_snprintf(buf, "%.2f %s", qwSize / (1024.0 * 1024 * 1024), ICQTranslateUtfStatic(LPGEN("GB"), szUnit, sizeof(szUnit)));
+	return null_strdup(buf);
+}
