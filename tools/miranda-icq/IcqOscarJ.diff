 // Release file transfer structure
+/////////////////////////////////////////////////////////////////////////////////////////
+// An incoming file request keeps a way to its accept dialog.
+//
+// The core adds a contact list event for it (Proto_RecvFile), keyed by its
+// database event. A message log that draws the request removes every event
+// with that key (DB::EventInfo::wipeNotify: IEView does it for each message
+// and file event it draws, whenever it draws it, e.g. on every redraw of an
+// open window; the built-in log for every SRMM event). With the contact's
+// window open the request then only shows in the log, and nothing leads to
+// the accept dialog. So the core's event is replaced at once by one of our
+// own, under a key the logs do not touch; it opens the same accept dialog and
+// goes when the request is answered.
+
+#define FILENOTIFY_KEY_BASE 0x7F000000
+
+static LONG g_iFileNotifySerial;
+
+// the core's accept dialog (mir_app, IDD_FILERECV) is open or being opened
+static BOOL CALLBACK FindRecvDialog(HWND hwnd, LPARAM lParam)
+{
+	wchar_t cls[16];
+	if (GetClassNameW(hwnd, cls, _countof(cls)) && !mir_wstrcmp(cls, L"#32770")
+		&& GetDlgItem(hwnd, 1213 /* IDC_FILEDIR */) && GetDlgItem(hwnd, 1208 /* IDC_FILENAMES */)) {
+		*(bool *)lParam = true;
+		return FALSE;
+	}
+	return TRUE;
+}
+
+static bool RecvDialogOpen()
+{
+	bool bFound = false;
+	EnumThreadWindows(GetCurrentThreadId(), FindRecvDialog, (LPARAM)&bFound);
+	return bFound;
+}
+
+void CIcqProto::AddFileRequestNotify(basic_filetransfer *bft)
+{
+	CLISTEVENT cle = {};
+	cle.hContact = bft->hContact;
+	cle.hDbEvent = bft->hRecvNotify = FILENOTIFY_KEY_BASE + (InterlockedIncrement(&g_iFileNotifySerial) & 0xFFFFFF);
+	cle.flags = CLEF_UNICODE;
+	cle.hIcon = Skin_LoadIcon(SKINICON_EVENT_FILE);
+	cle.lParam = (LPARAM)bft;
+	cle.pszService = m_szFileRequestService;
+
+	wchar_t szTooltip[256];
+	mir_snwprintf(szTooltip, TranslateT("File from %s"), Clist_GetContactDisplayName(bft->hContact));
+	cle.szTooltip.w = szTooltip;
+	g_clistApi.pfnAddEvent(&cle);
+	NetLog_Direct("File request %p: contact list event %x.", bft, bft->hRecvNotify);
+}
+
+struct FileNotifyRemoval
+{
+	MCONTACT hContact;
+	MEVENT hKey;
+};
+
+static void MIR_SYSCALL RemoveFileNotifyProc(void *param)
+{
+	FileNotifyRemoval *p = (FileNotifyRemoval *)param;
+	Clist_RemoveEvent(p->hContact, p->hKey);
+	delete p;
+}
+
+// The request was answered (or the transfer is going): its own event goes.
+void CIcqProto::RemoveFileRequestNotify(basic_filetransfer *bft)
+{
+	bft->bAnswered = true;
+	if (!bft->hRecvNotify)
+		return;
+
+	FileNotifyRemoval *p = new FileNotifyRemoval();
+	p->hContact = bft->hContact;
+	p->hKey = bft->hRecvNotify;
+	bft->hRecvNotify = 0;
+	CallFunctionAsync(RemoveFileNotifyProc, p);
+}
+
+// Right after the request was stored: its core event, unless an accept dialog
+// is already up (automatic accept), becomes ours.
+void CIcqProto::TakeOverFileRequestNotify(basic_filetransfer *bft)
+{
+	if (!bft->hRecvEvent || bft->bAnswered || RecvDialogOpen())
+		return;
+
+	Clist_RemoveEvent(bft->hContact, bft->hRecvEvent);
+	AddFileRequestNotify(bft);
