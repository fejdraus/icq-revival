// Type library compatible with Flash's "ShockwaveFlashObjects" (LIBID
// {D27CDB6B-AE6D-11CF-96B8-444553540000}, version 1.0).
//
// ICQ 6.5 sinks the player's events with ATL IDispEventImpl, which reads the
// event signatures from this library through LoadRegTypeLib. The method order
// of IShockwaveFlash matches Flash's own library, so the vtable slots line up:
// get_TotalFrames is slot 8 (+0x20) and GotoFrame slot 34 (+0x88).
//
// Rebuild typelib\flash.tlb with typelib\build-tlb.cmd after editing.

import "oaidl.idl";
import "ocidl.idl";

[
    uuid(D27CDB6B-AE6D-11CF-96B8-444553540000),
    version(1.0),
    helpstring("Shockwave Flash (Ruffle replacement for ICQ 6.5)")
]
library ShockwaveFlashObjects
{
    importlib("stdole2.tlb");

    interface IShockwaveFlash;
    dispinterface _IShockwaveFlashEvents;

    [
        uuid(D27CDB6C-AE6D-11CF-96B8-444553540000),
        helpstring("Shockwave Flash"),
        dual,
        oleautomation
    ]
    interface IShockwaveFlash : IDispatch
    {
        [propget, id(0xfffffdf3)] HRESULT ReadyState([out, retval] long* pVal);
        [propget, id(0x0000007c)] HRESULT TotalFrames([out, retval] long* pVal);
        [propget, id(0x0000007d)] HRESULT Playing([out, retval] VARIANT_BOOL* pVal);
        [propput, id(0x0000007d)] HRESULT Playing([in] VARIANT_BOOL pVal);
        [propget, id(0x00000069)] HRESULT Quality([out, retval] int* pVal);
        [propput, id(0x00000069)] HRESULT Quality([in] int pVal);
        [propget, id(0x00000078)] HRESULT ScaleMode([out, retval] int* pVal);
        [propput, id(0x00000078)] HRESULT ScaleMode([in] int pVal);
        [propget, id(0x00000079)] HRESULT AlignMode([out, retval] int* pVal);
        [propput, id(0x00000079)] HRESULT AlignMode([in] int pVal);
        [propget, id(0x0000007b)] HRESULT BackgroundColor([out, retval] long* pVal);
        [propput, id(0x0000007b)] HRESULT BackgroundColor([in] long pVal);
        [propget, id(0x0000006a)] HRESULT Loop([out, retval] VARIANT_BOOL* pVal);
        [propput, id(0x0000006a)] HRESULT Loop([in] VARIANT_BOOL pVal);
        [propget, id(0x00000066)] HRESULT Movie([out, retval] BSTR* pVal);
        [propput, id(0x00000066)] HRESULT Movie([in] BSTR pVal);
        [propget, id(0x0000006b)] HRESULT FrameNum([out, retval] long* pVal);
        [propput, id(0x0000006b)] HRESULT FrameNum([in] long pVal);
        [id(0x0000006d)] HRESULT SetZoomRect([in] long left, [in] long top, [in] long right, [in] long bottom);
        [id(0x00000076)] HRESULT Zoom([in] int factor);
        [id(0x00000077)] HRESULT Pan([in] long x, [in] long y, [in] int mode);
        [id(0x00000070)] HRESULT Play();
        [id(0x00000071)] HRESULT Stop();
        [id(0x00000072)] HRESULT Back();
        [id(0x00000073)] HRESULT Forward();
        [id(0x00000074)] HRESULT Rewind();
        [id(0x0000007e)] HRESULT StopPlay();
        [id(0x0000007f)] HRESULT GotoFrame([in] long FrameNum);
        [id(0x00000080)] HRESULT CurrentFrame([out, retval] long* FrameNum);
        [id(0x00000081)] HRESULT IsPlaying([out, retval] VARIANT_BOOL* Playing);
        [id(0x00000082)] HRESULT PercentLoaded([out, retval] long* percent);
        [id(0x00000083)] HRESULT FrameLoaded([in] long FrameNum, [out, retval] VARIANT_BOOL* loaded);
        [id(0x00000084)] HRESULT FlashVersion([out, retval] long* version);
        [propget, id(0x00000085)] HRESULT WMode([out, retval] BSTR* pVal);
        [propput, id(0x00000085)] HRESULT WMode([in] BSTR pVal);
        [propget, id(0x00000086)] HRESULT SAlign([out, retval] BSTR* pVal);
        [propput, id(0x00000086)] HRESULT SAlign([in] BSTR pVal);
        [propget, id(0x00000087)] HRESULT Menu([out, retval] VARIANT_BOOL* pVal);
        [propput, id(0x00000087)] HRESULT Menu([in] VARIANT_BOOL pVal);
        [propget, id(0x00000088)] HRESULT Base([out, retval] BSTR* pVal);
        [propput, id(0x00000088)] HRESULT Base([in] BSTR pVal);
        [propget, id(0x00000089)] HRESULT Scale([out, retval] BSTR* pVal);
        [propput, id(0x00000089)] HRESULT Scale([in] BSTR pVal);
        [propget, id(0x0000008a)] HRESULT DeviceFont([out, retval] VARIANT_BOOL* pVal);
        [propput, id(0x0000008a)] HRESULT DeviceFont([in] VARIANT_BOOL pVal);
        [propget, id(0x0000008b)] HRESULT EmbedMovie([out, retval] VARIANT_BOOL* pVal);
        [propput, id(0x0000008b)] HRESULT EmbedMovie([in] VARIANT_BOOL pVal);
        [propget, id(0x0000008c)] HRESULT BGColor([out, retval] BSTR* pVal);
        [propput, id(0x0000008c)] HRESULT BGColor([in] BSTR pVal);
        [propget, id(0x0000008d)] HRESULT Quality2([out, retval] BSTR* pVal);
        [propput, id(0x0000008d)] HRESULT Quality2([in] BSTR pVal);
        [id(0x0000008e)] HRESULT LoadMovie([in] int layer, [in] BSTR url);
        [id(0x0000008f)] HRESULT TGotoFrame([in] BSTR target, [in] long FrameNum);
        [id(0x00000090)] HRESULT TGotoLabel([in] BSTR target, [in] BSTR label);
        [id(0x00000091)] HRESULT TCurrentFrame([in] BSTR target, [out, retval] long* FrameNum);
        [id(0x00000092)] HRESULT TCurrentLabel([in] BSTR target, [out, retval] BSTR* pVal);
        [id(0x00000093)] HRESULT TPlay([in] BSTR target);
        [id(0x00000094)] HRESULT TStopPlay([in] BSTR target);
        [id(0x00000097)] HRESULT SetVariable([in] BSTR name, [in] BSTR value);
        [id(0x00000098)] HRESULT GetVariable([in] BSTR name, [out, retval] BSTR* pVal);
        [id(0x00000099)] HRESULT TSetProperty([in] BSTR target, [in] int property, [in] BSTR value);
        [id(0x0000009a)] HRESULT TGetProperty([in] BSTR target, [in] int property, [out, retval] BSTR* pVal);
        [id(0x0000009b)] HRESULT TCallFrame([in] BSTR target, [in] int FrameNum);
        [id(0x0000009c)] HRESULT TCallLabel([in] BSTR target, [in] BSTR label);
        [id(0x0000009d)] HRESULT TSetPropertyNum([in] BSTR target, [in] int property, [in] double value);
        [id(0x0000009e)] HRESULT TGetPropertyNum([in] BSTR target, [in] int property, [out, retval] double* pVal);
        [id(0x000000ac)] HRESULT TGetPropertyAsNumber([in] BSTR target, [in] int property, [out, retval] double* pVal);
        [propget, id(0x0000009f)] HRESULT SWRemote([out, retval] BSTR* pVal);
        [propput, id(0x0000009f)] HRESULT SWRemote([in] BSTR pVal);
        [propget, id(0x000000aa)] HRESULT FlashVars([out, retval] BSTR* pVal);
        [propput, id(0x000000aa)] HRESULT FlashVars([in] BSTR pVal);
        [propget, id(0x000000ab)] HRESULT AllowScriptAccess([out, retval] BSTR* pVal);
        [propput, id(0x000000ab)] HRESULT AllowScriptAccess([in] BSTR pVal);
        [propget, id(0x000000be)] HRESULT MovieData([out, retval] BSTR* pVal);
        [propput, id(0x000000be)] HRESULT MovieData([in] BSTR pVal);
        [propget, id(0x000000bf)] HRESULT InlineData([out, retval] IUnknown** ppIUnknown);
        [propput, id(0x000000bf)] HRESULT InlineData([in] IUnknown* ppIUnknown);
        [propget, id(0x000000c0)] HRESULT SeamlessTabbing([out, retval] VARIANT_BOOL* pVal);
        [propput, id(0x000000c0)] HRESULT SeamlessTabbing([in] VARIANT_BOOL pVal);
        [id(0x000000c1)] HRESULT EnforceLocalSecurity();
        [propget, id(0x000000c2)] HRESULT Profile([out, retval] VARIANT_BOOL* pVal);
        [propput, id(0x000000c2)] HRESULT Profile([in] VARIANT_BOOL pVal);
        [propget, id(0x000000c3)] HRESULT ProfileAddress([out, retval] BSTR* pVal);
        [propput, id(0x000000c3)] HRESULT ProfileAddress([in] BSTR pVal);
        [propget, id(0x000000c4)] HRESULT ProfilePort([out, retval] long* pVal);
        [propput, id(0x000000c4)] HRESULT ProfilePort([in] long pVal);
        [id(0x000000c6)] HRESULT CallFunction([in] BSTR request, [out, retval] BSTR* response);
        [id(0x000000c7)] HRESULT SetReturnValue([in] BSTR returnValue);
        [id(0x000000c8)] HRESULT DisableLocalSecurity();
        [propget, id(0x000000c9)] HRESULT AllowNetworking([out, retval] BSTR* pVal);
        [propput, id(0x000000c9)] HRESULT AllowNetworking([in] BSTR pVal);
        [propget, id(0x000000ca)] HRESULT AllowFullScreen([out, retval] BSTR* pVal);
        [propput, id(0x000000ca)] HRESULT AllowFullScreen([in] BSTR pVal);
    };

    [
        uuid(D27CDB6D-AE6D-11CF-96B8-444553540000),
        helpstring("Event interface for Shockwave Flash"),
        hidden
    ]
    dispinterface _IShockwaveFlashEvents
    {
        properties:
        methods:
            [id(0xfffffd9f)] void OnReadyStateChange(long newState);
            [id(0x000007a6)] void OnProgress(long percentDone);
            [id(0x00000096)] void FSCommand([in] BSTR command, [in] BSTR args);
            [id(0x000000c5)] void FlashCall([in] BSTR request);
    };

    [
        uuid(D27CDB6E-AE6D-11CF-96B8-444553540000),
        helpstring("Shockwave Flash")
    ]
    coclass ShockwaveFlash
    {
        [default] interface IShockwaveFlash;
        [default, source] dispinterface _IShockwaveFlashEvents;
    };
};
