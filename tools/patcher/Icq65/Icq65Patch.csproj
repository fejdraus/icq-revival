<Project Sdk="Microsoft.NET.Sdk">

  <!-- Patch for ICQ 6.5 (build 2024): one exe, nothing next to it. Built by
       tools\common\Build-Patches.ps1 into tools\icq65\patch\ICQ-6.5-Patch.exe. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ICQ-6.5-Patch</AssemblyName>
    <RootNamespace>IcqRevival.Patch</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Explorer shows the title as the file description, hence the client version. -->
    <AssemblyTitle>Patch for ICQ 6.5 (build 2024)</AssemblyTitle>
    <Description>Patch for ICQ 6.5 (build 2024)</Description>
    <Product>ICQ Revival</Product>
    <Company>ICQ Revival</Company>
    <Copyright>Copyright (c) 2026 ICQ Revival contributors</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- The same bytes from the same sources, wherever they are built. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)..=.</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled into each patch as source; shared with the other patches. -->
    <Compile Include="..\Common\*.cs" Link="Common\%(Filename)%(Extension)" />
    <!-- The flower of the ICQ Revival logo, which PatchIcon draws. -->
    <EmbeddedResource Include="..\Common\flower.png" LogicalName="flower.png" Link="Common\flower.png" />
  </ItemGroup>

  <!-- The SHA-256 of the E2E add-on DLL this patch hands out, written by
       tools\common\Build-Patches.ps1 (-p:E2eManifest=<file>) after it has
       built the DLL: the patch puts in only that DLL (E2eManifest in Common).
       Built without it, the patch accepts no add-on DLL. -->
  <ItemGroup Condition="'$(E2eManifest)' != ''">
    <EmbeddedResource Include="$(E2eManifest)" LogicalName="e2e-manifest.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
