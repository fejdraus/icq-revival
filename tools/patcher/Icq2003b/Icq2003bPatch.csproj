<Project Sdk="Microsoft.NET.Sdk">

  <!-- Patch for ICQ Pro 2003b (build 3916): one exe, nothing next to it. Built by
       tools\common\Build-Patches.ps1 into tools\icq2003b\patch\ICQ-2003b-Patch.exe. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ICQ-2003b-Patch</AssemblyName>
    <RootNamespace>IcqRevival.Patch</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Explorer shows the title as the file description, hence the client version. -->
    <AssemblyTitle>Patch for ICQ Pro 2003b (build 3916)</AssemblyTitle>
    <Description>Patch for ICQ Pro 2003b (build 3916)</Description>
    <Product>ICQ Revival</Product>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- The same bytes from the same sources, wherever they are built. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)..=.</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled into each patch as source; shared with the other patches. -->
    <Compile Include="..\Common\*.cs" Link="Common\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The build step of the translation runs in MSBuild, not in the exe. -->
    <Compile Remove="build\**" />
  </ItemGroup>

  <!-- The Ukrainian interface: decoded at build time from
       tools\icq2003b\patch\ICQ-2003b-uk-UA.txt, which stays the source, and
       carried as raw data and a readable index. -->
  <Import Project="build\ConvertTranslation.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
